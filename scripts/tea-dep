#!/usr/bin/env bash
# Manage issue dependencies via Forgejo/Gitea API
# Usage: tea-dep add <issue> <depends-on>
#        tea-dep rm <issue> <depends-on>
#        tea-dep list <issue>
#        tea-dep all                      — show all deps for open issues
#        tea-dep ready                    — find issues with no open blockers
#        tea-dep graph                    — text visualization of all deps
source "$(dirname "$0")/tea-api"

action="${1:?Usage: tea-dep <add|rm|list|all|ready|graph> ...}"

case "$action" in
  add)
    issue="${2:?Usage: tea-dep add <issue> <depends-on>}"
    dep="${3:?Usage: tea-dep add <issue> <depends-on>}"
    status=$(_api_post_status "issues/$issue/dependencies" "{\"index\": $dep, \"owner\": \"$OWNER\", \"repo\": \"$REPO\"}")
    case "$status" in
      201) echo "Added: #$issue depends on #$dep" ;;
      409) echo "Already exists: #$issue depends on #$dep" ;;
      *)   echo "Error (HTTP $status)" >&2; exit 1 ;;
    esac
    ;;

  rm)
    issue="${2:?Usage: tea-dep rm <issue> <depends-on>}"
    dep="${3:?Usage: tea-dep rm <issue> <depends-on>}"
    status=$(_api_delete_status "issues/$issue/dependencies" "{\"index\": $dep, \"owner\": \"$OWNER\", \"repo\": \"$REPO\"}")
    case "$status" in
      200) echo "Removed: #$issue no longer depends on #$dep" ;;
      *)   echo "Error (HTTP $status)" >&2; exit 1 ;;
    esac
    ;;

  list)
    issue="${2:?Usage: tea-dep list <issue>}"
    deps=$(_api_get "issues/$issue/dependencies")
    count=$(echo "$deps" | jq 'length')
    if [ "$count" = "0" ] || [ "$count" = "null" ]; then
      echo "Issue #$issue has no dependencies"
    else
      echo "Issue #$issue depends on:"
      echo "$deps" | jq -r '.[] | "  #\(.number) [\(.state)] \(.title)"'
    fi
    ;;

  all)
    found=0
    for i in $(tea issues list --output json | jq -r '.[].index'); do
      deps=$(_api_get "issues/$i/dependencies" | jq -r '.[].number' 2>/dev/null)
      if [ -n "$deps" ]; then
        echo "#$i depends on: $(echo $deps | tr '\n' ' ')"
        found=1
      fi
    done
    [ "$found" = "0" ] && echo "No dependencies found for open issues"
    ;;

  ready)
    echo "Issues with no open blockers:"
    for i in $(tea issues list --output json | jq -r '.[].index'); do
      open_blockers=$(_api_get "issues/$i/dependencies" | jq '[.[] | select(.state == "open")] | length')
      if [ "$open_blockers" = "0" ] || [ "$open_blockers" = "null" ]; then
        title=$(tea issues list --output json | jq -r ".[] | select(.index == $i) | .title")
        echo "  #$i $title"
      fi
    done
    ;;

  graph)
    echo "Dependency graph (A -> B means A depends on B):"
    echo "---"
    for i in $(tea issues list --state all --output json | jq -r '.[].index'); do
      deps=$(_api_get "issues/$i/dependencies" | jq -r '.[].number' 2>/dev/null)
      if [ -n "$deps" ]; then
        for d in $deps; do echo "  #$i -> #$d"; done
      fi
    done
    ;;

  *) echo "Unknown action: $action (use add, rm, list, all, ready, graph)" >&2; exit 1 ;;
esac
