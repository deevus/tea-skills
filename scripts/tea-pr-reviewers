#!/usr/bin/env bash
# Request or remove reviewers on a PR
# Usage: tea-pr-reviewers add <pr-number> <user1,user2,...>
#        tea-pr-reviewers remove <pr-number> <user1,user2,...>
source "$(dirname "$0")/tea-api"

action="${1:?Usage: tea-pr-reviewers <add|remove> <pr> <users>}"
pr="${2:?Usage: tea-pr-reviewers <add|remove> <pr> <users>}"
users="${3:?Usage: tea-pr-reviewers <add|remove> <pr> <users>}"

# Convert comma-separated to JSON array
json_users=$(echo "$users" | jq -R 'split(",")')

case "$action" in
  add)
    _api_post "pulls/$pr/requested_reviewers" "{\"reviewers\": $json_users}" > /dev/null && \
      echo "Requested review from $users on PR #$pr"
    ;;
  remove)
    _api_delete "pulls/$pr/requested_reviewers" "{\"reviewers\": $json_users}" && \
      echo "Removed review request from $users on PR #$pr"
    ;;
  *) echo "Unknown action: $action (use add or remove)" >&2; exit 1 ;;
esac
