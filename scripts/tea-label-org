#!/usr/bin/env bash
# Manage organization-level labels via API
# Usage: tea-label-org list
#        tea-label-org create <name> <color> [description]
source "$(dirname "$0")/tea-api"

ORG_API="$BASE_URL/api/v1/orgs/$OWNER"
action="${1:?Usage: tea-label-org <list|create> ...}"

case "$action" in
  list)
    curl -sf "$ORG_API/labels" -H "$(_auth)" | jq -r '.[] | "\(.name) \(.color) \(.description // "")"'
    ;;
  create)
    name="${2:?Usage: tea-label-org create <name> <color> [description]}"
    color="${3:?Usage: tea-label-org create <name> <color> [description]}"
    desc="${4:-}"
    curl -sf -X POST "$ORG_API/labels" -H "$(_auth)" -H "$(_json)" \
      -d "{\"name\": \"$name\", \"color\": \"$color\", \"description\": \"$desc\"}" | \
      jq -r '"Created org label: \(.name)"'
    ;;
  *) echo "Unknown action: $action (use list or create)" >&2; exit 1 ;;
esac
