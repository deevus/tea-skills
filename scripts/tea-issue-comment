#!/usr/bin/env bash
# Edit an issue comment via API (tea CLI can add/list but not edit)
# Usage: tea-issue-comment edit <comment-id> <body>
#
# For adding comments, use:    tea comment <issue> "body"
# For listing comments, use:   tea issues <issue> --comments
source "$(dirname "$0")/tea-api"

action="${1:?Usage: tea-issue-comment edit <comment-id> <body>}"

case "$action" in
  edit)
    comment_id="${2:?Usage: tea-issue-comment edit <comment-id> <body>}"
    body="${3:?Usage: tea-issue-comment edit <comment-id> <body>}"
    _api_patch "issues/comments/$comment_id" "{\"body\": $(echo "$body" | jq -Rs .)}" | jq -r '"Comment #\(.id) updated"'
    ;;
  *) echo "Unknown action: $action (only 'edit' supported — use 'tea comment' to add)" >&2; exit 1 ;;
esac
