#!/usr/bin/env bash
# Edit a milestone via API (tea CLI doesn't support this)
# Usage: tea-milestone-edit <milestone-name> --title <new-title>
#        tea-milestone-edit <milestone-name> --deadline <YYYY-MM-DD>
#        tea-milestone-edit <milestone-name> --description <text>
source "$(dirname "$0")/tea-api"

name="${1:?Usage: tea-milestone-edit <milestone-name> --title|--deadline|--description <value>}"
shift

MS_ID=$(_api_get "milestones?name=$name" | jq '.[0].id')
if [ "$MS_ID" = "null" ] || [ -z "$MS_ID" ]; then
  echo "Milestone '$name' not found" >&2; exit 1
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --title)
      _api_patch "milestones/$MS_ID" "{\"title\": \"$2\"}" > /dev/null && echo "Title updated to '$2'"
      shift 2 ;;
    --deadline)
      _api_patch "milestones/$MS_ID" "{\"due_on\": \"${2}T00:00:00Z\"}" > /dev/null && echo "Deadline updated to $2"
      shift 2 ;;
    --description)
      _api_patch "milestones/$MS_ID" "{\"description\": $(echo "$2" | jq -Rs .)}" > /dev/null && echo "Description updated"
      shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done
