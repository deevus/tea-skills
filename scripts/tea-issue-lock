#!/usr/bin/env bash
# Lock or unlock an issue
# Usage: tea-issue-lock <lock|unlock> <issue> [reason]
source "$(dirname "$0")/tea-api"

action="${1:?Usage: tea-issue-lock <lock|unlock> <issue> [reason]}"
issue="${2:?Usage: tea-issue-lock <lock|unlock> <issue> [reason]}"

case "$action" in
  lock)
    reason="${3:-resolved}"
    _api_post "issues/$issue/lock" "{\"lock_reason\": \"$reason\"}" > /dev/null && echo "Locked #$issue ($reason)"
    ;;
  unlock)
    _api_delete "issues/$issue/lock" && echo "Unlocked #$issue"
    ;;
  *) echo "Unknown action: $action (use lock or unlock)" >&2; exit 1 ;;
esac
